# Local dev only: the frontend (5173) and backend (4000) run as separate
# servers, so requests need a full cross-origin URL.
# On Vercel, leave this UNSET — the API is deployed as a serverless
# function in the same project (see api/index.js + vercel.json), so
# requests go to same-origin relative paths ("/api/...") instead.
VITE_API_URL=http://localhost:4000
